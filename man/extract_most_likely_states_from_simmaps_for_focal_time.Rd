abline(v = max(phytools::nodeHeights(mammals_cat_data$simmaps[[1]])[,2]) - focal_time,
       col = "red", lty = 2, lwd = 2)

# Plot updated stochastic map n°1, cut at 80 Mya
plot(mammals_cat_data_80My$simmaps[[1]], fsize = 0.7)
}

